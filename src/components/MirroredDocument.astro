---
import ClientBoot from "./ClientBoot.jsx";
import ContactPageSection from "./contact/ContactPageSection.astro";
import LocationsPageSection from "./locations/LocationsPageSection.astro";
import ServicesPageSection from "./services/ServicesPageSection.astro";
import type { ParsedMirroredPage } from "../lib/mirror";
import {
  DEFAULT_LOCALE,
  LOCALE_HTML_TAG,
  LOCALE_OG_TAG,
  SUPPORTED_LOCALES,
  injectLanguageSwitch,
  localizeInternalLinks,
  localizeNavigationLabels,
  localizePageContent,
  normalizeLocale,
  type Locale,
} from "../lib/i18n";
import {
  absoluteUrl,
  canonicalPathForLocale,
  extractTitleFromHead,
  getFooterKeywords,
  getJsonLd,
  getSeoDescription,
  getSeoImageUrl,
  getSeoKeywords,
  getSeoTitle,
} from "../lib/seo";

const { page, locale: localeProp } = Astro.props as {
  page: ParsedMirroredPage;
  locale?: string;
};

const locale = normalizeLocale(localeProp);
const localizedHeadHtml = localizeInternalLinks(page.headHtml, locale);
const sanitizedHeadHtml = localizedHeadHtml.replace(/<title[^>]*>[\s\S]*?<\/title>/i, "");
let localizedBodyHtml = localizeInternalLinks(page.bodyHtml, locale);
localizedBodyHtml = localizeNavigationLabels(localizedBodyHtml, locale);
localizedBodyHtml = localizePageContent(localizedBodyHtml, locale, page.route);
localizedBodyHtml = injectLanguageSwitch(localizedBodyHtml, page.route, locale);
localizedBodyHtml = localizedBodyHtml.replace(/©\s*Copyright\s*2024/gi, "© Copyright 2026");
if (!localizedBodyHtml.includes("o7digital.com")) {
  localizedBodyHtml = localizedBodyHtml.replace(
    /(<span class=['"]copyright['"][^>]*>)([\s\S]*?)(<\/span>)/i,
    `$1$2 | creado por <a href="https://www.o7digital.com/index-digital-agency" target="_blank" rel="noopener">o7digital.com</a>$3`,
  );
}

function splitFooterKeywords(keywords: string[], lineCount = 3): string[][] {
  if (keywords.length === 0) return [];

  const normalizedLineCount = Math.min(lineCount, keywords.length);
  const separatorLength = " · ".length;
  const lengths = keywords.map((keyword) => keyword.length);
  const prefixLengths = [0];

  for (const length of lengths) {
    prefixLengths.push(prefixLengths[prefixLengths.length - 1] + length);
  }

  const lineLength = (start: number, end: number): number => {
    const itemCount = end - start;
    return prefixLengths[end] - prefixLengths[start] + Math.max(0, itemCount - 1) * separatorLength;
  };

  const memo = new Map<string, { maxLength: number; cuts: number[] }>();

  const solve = (startIndex: number, groupCount: number): { maxLength: number; cuts: number[] } => {
    const memoKey = `${startIndex}:${groupCount}`;
    const cached = memo.get(memoKey);
    if (cached) return cached;

    if (groupCount === 1) {
      const result = {
        maxLength: lineLength(startIndex, keywords.length),
        cuts: [keywords.length],
      };
      memo.set(memoKey, result);
      return result;
    }

    let best = { maxLength: Number.POSITIVE_INFINITY, cuts: [] as number[] };

    for (
      let cutIndex = startIndex + 1;
      cutIndex <= keywords.length - (groupCount - 1);
      cutIndex += 1
    ) {
      const currentLineLength = lineLength(startIndex, cutIndex);
      const remaining = solve(cutIndex, groupCount - 1);
      const candidateMaxLength = Math.max(currentLineLength, remaining.maxLength);

      if (candidateMaxLength < best.maxLength) {
        best = {
          maxLength: candidateMaxLength,
          cuts: [cutIndex, ...remaining.cuts],
        };
      }
    }

    memo.set(memoKey, best);
    return best;
  };

  const bestPartition = solve(0, normalizedLineCount);
  const lines: string[][] = [];
  let startIndex = 0;

  for (const cutIndex of bestPartition.cuts) {
    lines.push(keywords.slice(startIndex, cutIndex));
    startIndex = cutIndex;
  }

  return lines;
}

function splitMirroredBodyForNativeSection(markup: string): { prefix: string; suffix: string } | null {
  const sectionStart = markup.indexOf("<div id='av_section_1'");
  const footerStart = markup.toLowerCase().lastIndexOf("<footer");

  if (sectionStart === -1 || footerStart === -1 || sectionStart >= footerStart) {
    return null;
  }

  return {
    prefix: markup.slice(0, sectionStart),
    suffix: markup.slice(footerStart),
  };
}

function injectMarkupBeforeLastFooter(markup: string, injectedMarkup: string): string {
  const footerCloseTag = "</footer>";
  const footerCloseIndex = markup.toLowerCase().lastIndexOf(footerCloseTag);

  if (footerCloseIndex === -1) {
    return markup;
  }

  return `${markup.slice(0, footerCloseIndex)}${injectedMarkup}${markup.slice(footerCloseIndex)}`;
}

function escapeHtmlAttribute(value: string): string {
  return value
    .replace(/&/g, "&amp;")
    .replace(/"/g, "&quot;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;");
}

function stripHtmlTags(value: string): string {
  return value.replace(/<[^>]+>/g, "").replace(/\s+/g, " ").trim();
}

function findBalancedDivEnd(markup: string, startIndex: number): number {
  const tagPattern = /<\/?div\b[^>]*>/gi;
  tagPattern.lastIndex = startIndex;
  let depth = 0;
  let match: RegExpExecArray | null;

  while ((match = tagPattern.exec(markup))) {
    if (match[0][1] === "/") {
      depth -= 1;
      if (depth === 0) {
        return tagPattern.lastIndex;
      }
    } else {
      depth += 1;
    }
  }

  return -1;
}

function replaceCollectionSlider(markup: string): string {
  const sliderClassIndex = markup.indexOf("class='avia-content-slider");
  if (sliderClassIndex === -1) {
    return markup;
  }

  const sliderStartIndex = markup.lastIndexOf("<div", sliderClassIndex);
  if (sliderStartIndex === -1) {
    return markup;
  }

  const sliderEndIndex = findBalancedDivEnd(markup, sliderStartIndex);
  if (sliderEndIndex === -1) {
    return markup;
  }

  const sliderMarkup = markup.slice(sliderStartIndex, sliderEndIndex);
  const articleMatches = sliderMarkup.match(/<article class='slide-entry[\s\S]*?<\/article>/g);

  if (!articleMatches?.length) {
    return markup;
  }

  const cards = articleMatches
    .map((articleMarkup) => {
      const href =
        articleMarkup.match(/<a href='([^']+)'[^>]*class='slide-image'/)?.[1] ??
        articleMarkup.match(/<a href="([^"]+)"[^>]*class="slide-image"/)?.[1];
      const imageSrc =
        articleMarkup.match(/data-src="([^"]+)"/)?.[1] ?? articleMarkup.match(/src="([^"]+)"/)?.[1];
      const imageWidth = articleMarkup.match(/width="([^"]+)"/)?.[1] ?? "495";
      const imageHeight = articleMarkup.match(/height="([^"]+)"/)?.[1] ?? "400";
      const titleHtml =
        articleMarkup.match(
          /<h3 class='slide-entry-title entry-title '\s+itemprop="headline"\s*><a [^>]*>([\s\S]*?)<\/a><\/h3>/,
        )?.[1] ??
        articleMarkup.match(
          /<h3 class="slide-entry-title entry-title "\s+itemprop="headline"\s*><a [^>]*>([\s\S]*?)<\/a><\/h3>/,
        )?.[1];

      if (!href || !imageSrc || !titleHtml) {
        return null;
      }

      const titleText = stripHtmlTags(titleHtml);

      return {
        href,
        imageSrc,
        imageWidth,
        imageHeight,
        titleHtml,
        titleText,
      };
    })
    .filter((card): card is NonNullable<typeof card> => card !== null);

  if (!cards.length) {
    return markup;
  }

  const replacementMarkup = `<div class="jld-collections-grid" itemscope="itemscope" itemtype="https://schema.org/ItemList">${cards
    .map(
      (card, index) => `<article class="jld-collections-card" itemprop="itemListElement" itemscope="itemscope" itemtype="https://schema.org/CreativeWork">
  <a href="${escapeHtmlAttribute(card.href)}" class="jld-collections-card__image" title="${escapeHtmlAttribute(card.titleText)}" itemprop="url">
    <img src="${escapeHtmlAttribute(card.imageSrc)}" alt="${escapeHtmlAttribute(card.titleText)}" width="${escapeHtmlAttribute(card.imageWidth)}" height="${escapeHtmlAttribute(card.imageHeight)}" loading="${index === 0 ? "eager" : "lazy"}" decoding="async" itemprop="image" />
  </a>
  <div class="jld-collections-card__content">
    <header class="entry-content-header">
      <h3 class="slide-entry-title entry-title" itemprop="headline"><a href="${escapeHtmlAttribute(card.href)}">${card.titleHtml}</a></h3>
      <span class="av-vertical-delimiter"></span>
    </header>
  </div>
</article>`,
    )
    .join("")}</div>`;

  return `${markup.slice(0, sliderStartIndex)}${replacementMarkup}${markup.slice(sliderEndIndex)}`;
}

if (page.route === "/colecciones/") {
  localizedBodyHtml = replaceCollectionSlider(localizedBodyHtml);
}

// Inject footer keywords
const footerKeywords = getFooterKeywords(locale);
if (footerKeywords.length > 0) {
  const footerKeywordLines = splitFooterKeywords(footerKeywords);
  const keywordsHtml = `<div class="footerKeywords" aria-label="SEO keywords">${footerKeywordLines
    .map((line) => `<p class="footerKeywords__line">${line.join(" · ")}</p>`)
    .join("")}</div>`;
  localizedBodyHtml = injectMarkupBeforeLastFooter(localizedBodyHtml, keywordsHtml);
}

const fallbackTitle = extractTitleFromHead(localizedHeadHtml);
const title = getSeoTitle(page.route, fallbackTitle, locale);
const description = getSeoDescription(page.route, locale);
const keywords = getSeoKeywords(page.route, locale);
const canonical = absoluteUrl(canonicalPathForLocale(page.route, locale));
const xDefaultCanonical = absoluteUrl(canonicalPathForLocale(page.route, DEFAULT_LOCALE));
const alternateLinks = SUPPORTED_LOCALES.map((entryLocale) => ({
  locale: entryLocale,
  href: absoluteUrl(canonicalPathForLocale(page.route, entryLocale)),
  hreflang: LOCALE_HTML_TAG[entryLocale],
}));
const ogLocaleAlternates = SUPPORTED_LOCALES.filter(
  (entryLocale): entryLocale is Locale => entryLocale !== locale,
).map((entryLocale) => LOCALE_OG_TAG[entryLocale]);
const ogImage = getSeoImageUrl(page.route);
const jsonLd = getJsonLd({
  canonical,
  description,
  route: page.route,
  title,
  locale,
});
const hasBodyH1 = /<h1\b/i.test(localizedBodyHtml);
const pageHeading = title.replace(/\s*-\s*Jean Louis David\s*$/i, "").trim();
const ogImageAlt = pageHeading || "Jean Louis David Mexico";
const nativeBodyShell = new Set(["/servicios/", "/sucursales/", "/contacto/"]).has(page.route)
  ? splitMirroredBodyForNativeSection(localizedBodyHtml)
  : null;
---

<!doctype html>
<html lang={LOCALE_HTML_TAG[locale]} class={page.htmlClass || undefined}>
  <head>
    <Fragment set:html={sanitizedHeadHtml} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    {alternateLinks.map((entry) => (
      <link rel="alternate" hreflang={entry.hreflang} href={entry.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultCanonical} />
    <meta property="og:site_name" content="Jean Louis David Mexico" />
    <meta property="og:locale" content={LOCALE_OG_TAG[locale]} />
    {ogLocaleAlternates.map((entryLocale) => (
      <meta property="og:locale:alternate" content={entryLocale} />
    ))}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-SFV4K3F3LG"></script>
    <script is:inline src="/gtag.js"></script>
    <script is:inline type="application/ld+json" set:html={jsonLd} />
    <style is:global>
      #full_slider_1 .avia-slideshow-inner > li,
      .avia-fullscreen-slider .avia-slideshow-inner > li {
        position: absolute;
        top: 0;
        left: 0;
      }

      #full_slider_1 .avia-slideshow-inner > li:first-child {
        position: relative;
        opacity: 1;
      }

      .avia-fullscreen-slider .avia-slideshow-inner > li:first-child {
        opacity: 1;
      }

      body.page-id-164 .jld-collections-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        column-gap: 90px;
        row-gap: 36px;
        margin: 30px 0 40px;
        align-items: start;
      }

      body.page-id-164 .jld-collections-card {
        min-width: 0;
      }

      body.page-id-164 .jld-collections-card__image {
        display: block;
        overflow: hidden;
        margin: 0 0 6px;
        border-radius: 3px;
      }

      body.page-id-164 .jld-collections-card__image img {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 3px;
      }

      body.page-id-164 .jld-collections-card__content {
        position: static;
        margin: 0;
      }

      body.page-id-164 .jld-collections-card__content .slide-entry-title {
        margin: 0;
        font-size: 1.1em;
        line-height: 1.4em;
      }

      body.page-id-164 .jld-collections-card__content .av-vertical-delimiter {
        display: none;
      }

      @media (max-width: 989px) {
        body.page-id-164 .jld-collections-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          column-gap: 40px;
          row-gap: 28px;
        }
      }

      @media (max-width: 767px) {
        body.page-id-164 .jld-collections-grid {
          grid-template-columns: minmax(0, 1fr);
          margin-bottom: 24px;
        }
      }

      #menu-item-language-switch {
        position: relative;
      }

      #menu-item-language-switch .jld-lang-switch__details {
        position: relative;
        height: 100%;
      }

      #menu-item-language-switch .jld-lang-switch__summary {
        list-style: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        height: 88px;
        line-height: 88px;
        padding: 0 13px;
        text-transform: uppercase;
        font-size: 13px;
        font-weight: 600;
        color: inherit;
        cursor: pointer;
        user-select: none;
      }

      #menu-item-language-switch .jld-lang-switch__summary::-webkit-details-marker {
        display: none;
      }

      #menu-item-language-switch .jld-lang-switch__summary::marker {
        content: "";
      }

      #menu-item-language-switch .jld-lang-switch__caret {
        width: 6px;
        height: 6px;
        margin-top: -3px;
        border-right: 1px solid currentColor;
        border-bottom: 1px solid currentColor;
        transform: rotate(45deg);
      }

      #menu-item-language-switch .jld-lang-switch__menu {
        position: absolute;
        top: calc(100% + 2px);
        right: 0;
        min-width: 56px;
        margin: 0;
        padding: 4px 0;
        list-style: none;
        border-radius: 6px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        background: #1f2024;
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.22);
        z-index: 600;
      }

      #menu-item-language-switch .jld-lang-switch__menu > li {
        margin: 0;
        float: none !important;
        display: block !important;
        width: 100%;
      }

      #menu-item-language-switch .jld-lang-switch__link {
        display: block;
        height: auto !important;
        line-height: 1.2 !important;
        padding: 8px 12px !important;
        text-decoration: none;
        color: #f4f4f4;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.04em;
      }

      #menu-item-language-switch .jld-lang-switch__link:hover,
      #menu-item-language-switch .jld-lang-switch__link:focus-visible,
      #menu-item-language-switch .jld-lang-switch__link.is-active {
        color: #d7bb7a;
      }

      .footerKeywords {
        margin: 18px auto 0;
        width: min(1600px, calc(100vw - 48px));
        max-width: none;
        padding: 0 24px 14px;
        text-align: center;
        font-size: 11px;
        line-height: 1.85;
        color: rgba(194, 194, 194, 0.72);
        opacity: 0.82;
        white-space: normal;
        overflow-wrap: anywhere;
      }

      .footerKeywords__line {
        margin: 0;
      }

      .footerKeywords__line + .footerKeywords__line {
        margin-top: 4px;
      }

      @media (min-width: 1024px) {
        .footerKeywords__line {
          white-space: nowrap;
        }
      }

      @media (min-width: 768px) {
        #menu-item-language-switch .jld-lang-switch__details:not([open]) .jld-lang-switch__menu {
          display: none;
        }
      }

      @media (min-width: 990px) {
        .av-desktop-hide {
          display: none !important;
        }

        .avia-fullscreen-slider {
          display: none !important;
        }
      }

      @media (min-width: 768px) and (max-width: 989px) {
        .av-medium-hide {
          display: none !important;
        }
      }

      @media (min-width: 480px) and (max-width: 767px) {
        .av-small-hide {
          display: none !important;
        }
      }

      @media (max-width: 767px) {
        #menu-item-language-switch {
          display: none !important;
        }

        .footerKeywords {
          width: auto;
          max-width: 92%;
          padding: 0 16px 14px;
          font-size: 11px;
          line-height: 1.8;
        }
      }

      @media (max-width: 479px) {
        .av-mini-hide {
          display: none !important;
        }
      }

      @media (max-width: 767px) {
        .avia-fullwidth-slider.av-small-hide.av-mini-hide {
          display: none !important;
        }
      }

      /* Fallback styles for Enfold mobile burger overlay.
         Some mirrored LiteSpeed CSS snapshots omit these rules. */
      @media (max-width: 767px) {
        .av-burger-overlay {
          position: fixed;
          inset: 0;
          z-index: 1200;
          display: none;
          opacity: 0;
        }

        .av-burger-overlay-bg {
          position: absolute;
          inset: 0;
          background: rgba(0, 0, 0, 0.5);
          z-index: 1;
          opacity: 0;
          transition: opacity 0.3s ease;
        }

        .av-burger-overlay-scroll {
          position: absolute;
          top: 0;
          right: 0;
          height: 100%;
          width: min(82vw, 430px);
          background: #1f2024;
          z-index: 2;
          transform: translateX(100%);
          transition: transform 0.3s ease;
          overflow-y: auto;
          -webkit-overflow-scrolling: touch;
          box-shadow: -18px 0 42px rgba(0, 0, 0, 0.45);
        }

        .av-burger-overlay-inner {
          position: relative;
          z-index: 2;
          min-height: 100%;
          padding: 96px 0 28px;
        }

        html.av-burger-overlay-active .av-burger-overlay-bg {
          opacity: 1;
        }

        html.av-burger-overlay-active .av-burger-overlay-scroll {
          transform: translateX(0);
        }

        #av-burger-menu-ul {
          position: relative;
          z-index: 3;
          margin: 0;
          padding: 0;
          list-style: none;
        }

        #av-burger-menu-ul > li {
          margin: 0;
          opacity: 0;
          transform: translateX(16px);
          pointer-events: auto !important;
          transition:
            opacity 0.25s ease,
            transform 0.25s ease;
        }

        #av-burger-menu-ul > li.av-active-burger-items {
          opacity: 1;
          transform: translateX(0);
        }

        #av-burger-menu-ul > li > a {
          display: block;
          margin: 0;
          padding: 18px 34px;
          border-bottom: 1px solid rgba(255, 255, 255, 0.22);
          color: #f4f4f4 !important;
          font-family: "playfair display", Helvetica, Arial, sans-serif;
          font-size: clamp(2.1rem, 8.3vw, 2.55rem);
          font-weight: 400;
          line-height: 1.12;
          text-decoration: none;
          background: transparent !important;
          pointer-events: auto !important;
        }

        #av-burger-menu-ul > li > a .avia-menu-text {
          color: inherit !important;
        }

        #av-burger-menu-ul > li > a .avia-menu-fx,
        #av-burger-menu-ul > li > a .avia-bullet {
          display: none !important;
        }

        .av-width-submenu > a {
          position: relative;
          padding-right: 56px !important;
        }

        .av-width-submenu > a .av-submenu-indicator {
          position: absolute;
          right: 26px;
          top: 50%;
          width: 11px;
          height: 11px;
          margin-top: -5px;
          border-right: 1px solid rgba(255, 255, 255, 0.85);
          border-bottom: 1px solid rgba(255, 255, 255, 0.85);
          transform: rotate(45deg);
        }

        #av-burger-menu-ul .sub-menu {
          margin: 0;
          padding: 0;
          background: rgba(255, 255, 255, 0.04);
        }

        #av-burger-menu-ul .sub-menu > li > a {
          font-size: clamp(1.65rem, 6.8vw, 2.05rem);
          padding-left: 46px;
        }

        #av-burger-menu-ul > li.jld-mobile-lang-item {
          opacity: 1 !important;
          transform: translateX(0) !important;
          padding: 16px 34px 6px;
          border-bottom: 1px solid rgba(255, 255, 255, 0.22);
        }

        #av-burger-menu-ul > li.jld-mobile-lang-item .jld-mobile-lang-links {
          display: flex;
          align-items: center;
          gap: 10px;
        }

        #av-burger-menu-ul > li.jld-mobile-lang-item .jld-mobile-lang__link {
          display: inline-flex;
          align-items: center;
          justify-content: center;
          min-width: 46px;
          padding: 8px 12px;
          border: 1px solid rgba(255, 255, 255, 0.35);
          color: #f4f4f4 !important;
          font-family: "cabin", Helvetica, Arial, sans-serif;
          font-size: 14px;
          font-weight: 700;
          letter-spacing: 0.08em;
          line-height: 1;
          text-decoration: none;
          text-transform: uppercase;
          background: transparent;
        }

        #av-burger-menu-ul > li.jld-mobile-lang-item .jld-mobile-lang__link:hover,
        #av-burger-menu-ul > li.jld-mobile-lang-item .jld-mobile-lang__link:focus-visible,
        #av-burger-menu-ul > li.jld-mobile-lang-item .jld-mobile-lang__link.is-active {
          background: #d7bb7a;
          border-color: #d7bb7a;
          color: #1f2024 !important;
        }

        .av-hamburger--spin.is-active .av-hamburger-inner {
          transform: rotate(225deg);
          transition-delay: 0.12s;
          transition-timing-function: cubic-bezier(0.215, 0.61, 0.355, 1);
        }

        .av-hamburger--spin.is-active .av-hamburger-inner::before {
          top: 0;
          opacity: 0;
          transition:
            top 0.1s ease-out,
            opacity 0.1s 0.12s ease-out;
        }

        .av-hamburger--spin.is-active .av-hamburger-inner::after {
          bottom: 0;
          transform: rotate(-90deg);
          transition:
            bottom 0.1s ease-out,
            transform 0.22s 0.12s cubic-bezier(0.215, 0.61, 0.355, 1);
        }
      }

      .av-masonry-container.av-js-disabled .av-masonry-entry {
        visibility: visible;
        opacity: 1;
      }

      .av-masonry-container.av-js-disabled .av-masonry-entry.av-masonry-item-no-image {
        display: none;
      }

      /* Contact form: keep submit button aligned below inputs and make it readable. */
      body.page-id-150 #top .avia_ajax_form p.form_element:not(.form_fullwidth) {
        clear: both !important;
        float: none !important;
        display: block !important;
        width: 100% !important;
        margin: 18px 0 0 !important;
        text-align: left !important;
        position: static !important;
      }

      body.page-id-150 #top .avia_ajax_form p.jld-submit-row {
        clear: both !important;
        float: none !important;
        display: block !important;
        width: 100% !important;
        margin: 18px 0 0 !important;
        text-align: left !important;
      }

      body.page-id-150 #top .avia_ajax_form p.form_element:not(.form_fullwidth) input[type="submit"].button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        max-width: 420px;
        min-height: 54px;
        padding: 0 24px;
        border: 1px solid #b79d69;
        border-radius: 2px;
        background: #b79d69;
        color: #fff;
        font-size: 15px;
        font-weight: 700;
        letter-spacing: 0.02em;
        line-height: 1.2;
        text-transform: uppercase;
        white-space: normal;
        float: none !important;
        margin: 0 !important;
      }

      body.page-id-150 #top .avia_ajax_form p.jld-submit-row input[type="submit"].button {
        display: inline-flex !important;
        align-items: center;
        justify-content: center;
        width: 100%;
        max-width: 420px;
        min-height: 54px;
        padding: 0 24px;
        border: 1px solid #b79d69;
        border-radius: 2px;
        background: #b79d69;
        color: #fff;
        font-size: 15px;
        font-weight: 700;
        letter-spacing: 0.02em;
        line-height: 1.2;
        text-transform: uppercase;
        white-space: normal;
        float: none !important;
        margin: 0 !important;
      }

      body.page-id-150 #top .avia_ajax_form p.form_element:not(.form_fullwidth) input[type="submit"].button:hover,
      body.page-id-150 #top .avia_ajax_form p.form_element:not(.form_fullwidth) input[type="submit"].button:focus-visible,
      body.page-id-150 #top .avia_ajax_form p.jld-submit-row input[type="submit"].button:hover,
      body.page-id-150 #top .avia_ajax_form p.jld-submit-row input[type="submit"].button:focus-visible {
        background: #ceb27a;
        border-color: #ceb27a;
        color: #1f2024;
      }

      @media (max-width: 767px) {
        body.page-id-150 #top .avia_ajax_form p.form_element:not(.form_fullwidth) input[type="submit"].button {
          max-width: none;
        }
      }

      .jld-visually-hidden {
        position: absolute !important;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }
    </style>
  </head>
  <body id="top" class={page.bodyClass || undefined}>
    <ClientBoot client:load route={canonicalPathForLocale(page.route, locale)} />
    {!hasBodyH1 && <h1 class="jld-visually-hidden">{pageHeading}</h1>}
    {nativeBodyShell ? (
      <>
        <Fragment set:html={nativeBodyShell.prefix} />
        {page.route === "/servicios/" ? (
          <ServicesPageSection locale={locale} />
        ) : page.route === "/sucursales/" ? (
          <LocationsPageSection locale={locale} />
        ) : page.route === "/contacto/" ? (
          <ContactPageSection locale={locale} />
        ) : null}
        <Fragment set:html={nativeBodyShell.suffix} />
      </>
    ) : (
      <Fragment set:html={localizedBodyHtml} />
    )}
  </body>
</html>
