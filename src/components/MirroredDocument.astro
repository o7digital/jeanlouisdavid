---
import type { ParsedMirroredPage } from "../lib/mirror";
import {
  DEFAULT_LOCALE,
  LOCALE_CODE_LABEL,
  LOCALE_HTML_TAG,
  LOCALE_OG_TAG,
  SUPPORTED_LOCALES,
  injectLanguageSwitch,
  localizeInternalLinks,
  localizeNavigationLabels,
  localizePageContent,
  normalizeLocale,
  type Locale,
} from "../lib/i18n";
import {
  absoluteUrl,
  canonicalPathForLocale,
  extractTitleFromHead,
  getJsonLd,
  getSeoDescription,
  getSeoImageUrl,
  getSeoTitle,
} from "../lib/seo";

const { page, locale: localeProp } = Astro.props as {
  page: ParsedMirroredPage;
  locale?: string;
};

const FORMSPREE_ENDPOINT = "https://formspree.io/f/xkovvbwz";

function configureContactForm(markup: string): string {
  if (!markup) return markup;

  let normalized = markup;

  normalized = normalized.replace(
    /<form([^>]*class=(["'])[^"']*avia_ajax_form[^"']*\2[^>]*)>/gi,
    (_match: string, attributes: string): string => {
      let nextAttributes = attributes;

      if (/\baction=/.test(nextAttributes)) {
        nextAttributes = nextAttributes.replace(
          /\baction=(["'])[^"']*\1/i,
          `action="${FORMSPREE_ENDPOINT}"`,
        );
      } else {
        nextAttributes += ` action="${FORMSPREE_ENDPOINT}"`;
      }

      if (/\bmethod=/.test(nextAttributes)) {
        nextAttributes = nextAttributes.replace(/\bmethod=(["'])[^"']*\1/i, `method="post"`);
      } else {
        nextAttributes += ` method="post"`;
      }

      if (!/\baccept-charset=/.test(nextAttributes)) {
        nextAttributes += ` accept-charset="UTF-8"`;
      }

      return `<form${nextAttributes}>`;
    },
  );

  normalized = normalized.replace(/\bname=(["'])avia_1_1\1/gi, `name="name"`);
  normalized = normalized.replace(/\bname=(["'])avia_2_1\1/gi, `name="phone"`);
  normalized = normalized.replace(/\bname=(["'])avia_3_1\1/gi, `name="email"`);
  normalized = normalized.replace(/\bname=(["'])avia_4_1\1/gi, `name="message"`);

  normalized = normalized.replace(
    /<p[^>]*class=(["'])hidden\1[^>]*>\s*<input[^>]*name=(["'])avia_5_1\2[^>]*>\s*<\/p>\s*/gi,
    "",
  );
  normalized = normalized.replace(
    /<input[^>]*name=(["'])avia_generated_form1\1[^>]*>\s*/gi,
    "",
  );
  normalized = normalized.replace(
    /<div[^>]*class=(["'])[^"']*av-recaptcha-area[^"']*\1[^>]*>[\s\S]*?<\/div>(?:\s*<\/div>)?\s*/gi,
    "",
  );
  normalized = normalized.replace(
    /<div[^>]*class=(["'])avia-disabled-form\1[^>]*>[\s\S]*?<\/div>\s*/gi,
    "",
  );

  return normalized;
}

function cleanupPrivacyCopy(markup: string, locale: Locale): string {
  if (!markup) return markup;
  if (locale === "es") return markup;

  let normalized = markup;
  normalized = normalized.replace(/SERVIC&#73;OS/gi, "SERVICIOS");

  if (locale === "fr") {
    normalized = normalized.replace(
      /RESPONSABLE DU TRAITEMENT DU TRAITEMENT/gi,
      "RESPONSABLE DU TRAITEMENT",
    );
  }

  return normalized;
}

const locale = normalizeLocale(localeProp);
const localizedHeadHtml = localizeInternalLinks(page.headHtml, locale);
const sanitizedHeadHtml = localizedHeadHtml.replace(/<title[^>]*>[\s\S]*?<\/title>/i, "");
let localizedBodyHtml = localizeInternalLinks(page.bodyHtml, locale);
localizedBodyHtml = localizeNavigationLabels(localizedBodyHtml, locale);
localizedBodyHtml = localizePageContent(localizedBodyHtml, locale, page.route);
localizedBodyHtml = injectLanguageSwitch(localizedBodyHtml, page.route, locale);
if (page.route === "/contacto/") {
  localizedBodyHtml = configureContactForm(localizedBodyHtml);
}
if (page.route === "/privacidad/") {
  localizedBodyHtml = cleanupPrivacyCopy(localizedBodyHtml, locale);
}
localizedBodyHtml = localizedBodyHtml.replace(/©\s*Copyright\s*2024/gi, "© Copyright 2026");
if (!localizedBodyHtml.includes("o7digital.com")) {
  localizedBodyHtml = localizedBodyHtml.replace(
    /(<span class=['"]copyright['"][^>]*>)([\s\S]*?)(<\/span>)/i,
    `$1$2 | creado por <a href="https://www.o7digital.com/index-digital-agency" target="_blank" rel="noopener">o7digital.com</a>$3`,
  );
}

const fallbackTitle = extractTitleFromHead(localizedHeadHtml);
const title = getSeoTitle(page.route, fallbackTitle, locale);
const description = getSeoDescription(page.route, locale);
const canonical = absoluteUrl(canonicalPathForLocale(page.route, locale));
const xDefaultCanonical = absoluteUrl(canonicalPathForLocale(page.route, DEFAULT_LOCALE));
const alternateLinks = SUPPORTED_LOCALES.map((entryLocale) => ({
  locale: entryLocale,
  href: absoluteUrl(canonicalPathForLocale(page.route, entryLocale)),
  hreflang: LOCALE_HTML_TAG[entryLocale],
}));
const ogLocaleAlternates = SUPPORTED_LOCALES.filter(
  (entryLocale): entryLocale is Locale => entryLocale !== locale,
).map((entryLocale) => LOCALE_OG_TAG[entryLocale]);
const ogImage = getSeoImageUrl();
const jsonLd = getJsonLd({
  canonical,
  description,
  route: page.route,
  title,
  locale,
});
const hasBodyH1 = /<h1\b/i.test(localizedBodyHtml);
const pageHeading = title.replace(/\s*-\s*Jean Louis David\s*$/i, "").trim();
const clientBootRoute = canonicalPathForLocale(page.route, locale);
const mobileLanguageLabel = locale === "fr" ? "Langue" : locale === "en" ? "Language" : "Idioma";
const mobileLanguageLinks = SUPPORTED_LOCALES.map((entryLocale) => ({
  code: LOCALE_CODE_LABEL[entryLocale],
  href: canonicalPathForLocale(page.route, entryLocale),
  localeTag: LOCALE_HTML_TAG[entryLocale],
  active: entryLocale === locale,
}));
---

<!doctype html>
<html lang={LOCALE_HTML_TAG[locale]} class={page.htmlClass || undefined}>
  <head>
    <Fragment set:html={sanitizedHeadHtml} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    {alternateLinks.map((entry) => (
      <link rel="alternate" hreflang={entry.hreflang} href={entry.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultCanonical} />
    <meta property="og:site_name" content="Jean Louis David Mexico" />
    <meta property="og:locale" content={LOCALE_OG_TAG[locale]} />
    {ogLocaleAlternates.map((entryLocale) => (
      <meta property="og:locale:alternate" content={entryLocale} />
    ))}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Jean Louis David Mexico" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={jsonLd} />
    <style is:global>
      #full_slider_1 .avia-slideshow-inner > li,
      .avia-fullscreen-slider .avia-slideshow-inner > li {
        position: absolute;
        top: 0;
        left: 0;
      }

      #full_slider_1 .avia-slideshow-inner > li:first-child {
        position: relative;
        opacity: 1;
      }

      .avia-fullscreen-slider .avia-slideshow-inner > li:first-child {
        opacity: 1;
      }

      /* Keep collection card titles directly under each image across locales. */
      body.page-id-164 #top .avia-content-slider .slide-entry {
        display: flex;
        flex-direction: column;
      }

      body.page-id-164 #top .avia-content-slider .slide-entry .slide-image,
      body.page-id-164 #top .avia-content-slider .slide-entry .slide-content {
        width: 100%;
      }

      body.page-id-164 #top .avia-content-slider .slide-entry .slide-content {
        position: static !important;
        margin-top: 0 !important;
      }

      #menu-item-language-switch {
        position: relative;
      }

      #menu-item-language-switch .jld-lang-switch__details {
        position: relative;
        height: 100%;
      }

      #menu-item-language-switch .jld-lang-switch__summary {
        list-style: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        height: 88px;
        line-height: 88px;
        padding: 0 13px;
        text-transform: uppercase;
        font-size: 13px;
        font-weight: 600;
        color: inherit;
        cursor: pointer;
        user-select: none;
      }

      #menu-item-language-switch .jld-lang-switch__summary::-webkit-details-marker {
        display: none;
      }

      #menu-item-language-switch .jld-lang-switch__summary::marker {
        content: "";
      }

      #menu-item-language-switch .jld-lang-switch__caret {
        width: 6px;
        height: 6px;
        margin-top: -3px;
        border-right: 1px solid currentColor;
        border-bottom: 1px solid currentColor;
        transform: rotate(45deg);
      }

      #menu-item-language-switch .jld-lang-switch__menu {
        position: absolute;
        top: calc(100% + 2px);
        right: 0;
        min-width: 56px;
        margin: 0;
        padding: 4px 0;
        list-style: none;
        border-radius: 6px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        background: #1f2024;
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.22);
        z-index: 600;
      }

      #menu-item-language-switch .jld-lang-switch__menu > li {
        margin: 0;
        float: none !important;
        display: block !important;
        width: 100%;
      }

      #menu-item-language-switch .jld-lang-switch__link {
        display: block;
        height: auto !important;
        line-height: 1.2 !important;
        padding: 8px 12px !important;
        text-decoration: none;
        color: #f4f4f4;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.04em;
      }

      #menu-item-language-switch .jld-lang-switch__link:hover,
      #menu-item-language-switch .jld-lang-switch__link:focus-visible,
      #menu-item-language-switch .jld-lang-switch__link.is-active {
        color: #d7bb7a;
      }

      @media (min-width: 768px) {
        #menu-item-language-switch .jld-lang-switch__details:not([open]) .jld-lang-switch__menu {
          display: none;
        }
      }

      @media (min-width: 990px) {
        .av-desktop-hide {
          display: none !important;
        }

        .avia-fullscreen-slider {
          display: none !important;
        }
      }

      @media (min-width: 768px) and (max-width: 989px) {
        .av-medium-hide {
          display: none !important;
        }
      }

      @media (min-width: 480px) and (max-width: 767px) {
        .av-small-hide {
          display: none !important;
        }
      }

      @media (max-width: 767px) {
        #menu-item-language-switch {
          display: none !important;
        }
      }

      @media (max-width: 479px) {
        .av-mini-hide {
          display: none !important;
        }
      }

      @media (max-width: 767px) {
        .avia-fullwidth-slider.av-small-hide.av-mini-hide {
          display: none !important;
        }
      }

      /* Fallback styles for Enfold mobile burger overlay.
         Some mirrored LiteSpeed CSS snapshots omit these rules. */
      @media (max-width: 767px) {
        .av-burger-overlay {
          position: fixed;
          inset: 0;
          z-index: 1200;
          display: none;
          opacity: 0;
        }

        .av-burger-overlay-bg {
          position: absolute;
          inset: 0;
          background: rgba(0, 0, 0, 0.5);
          opacity: 0;
          transition: opacity 0.3s ease;
        }

        .av-burger-overlay-scroll {
          position: absolute;
          top: 0;
          right: 0;
          height: 100%;
          width: min(88vw, 430px);
          background: #1f2024;
          transform: translateX(100%);
          transition: transform 0.3s ease;
          overflow-y: auto;
          -webkit-overflow-scrolling: touch;
          box-shadow: -18px 0 42px rgba(0, 0, 0, 0.45);
        }

        .av-burger-overlay-inner {
          min-height: 100%;
          padding: 96px 0 28px;
        }

        html.av-burger-overlay-active .av-burger-overlay-bg {
          opacity: 1;
        }

        html.av-burger-overlay-active .av-burger-overlay-scroll {
          transform: translateX(0);
        }

        #av-burger-menu-ul {
          margin: 0;
          padding: 0;
          list-style: none;
        }

        #av-burger-menu-ul > li {
          margin: 0;
          opacity: 0;
          transform: translateX(16px);
          transition:
            opacity 0.25s ease,
            transform 0.25s ease;
        }

        #av-burger-menu-ul > li.av-active-burger-items {
          opacity: 1;
          transform: translateX(0);
        }

        #av-burger-menu-ul > li > a {
          display: block;
          margin: 0;
          padding: 18px 34px;
          border-bottom: 1px solid rgba(255, 255, 255, 0.22);
          color: #f4f4f4 !important;
          font-family: "playfair display", Helvetica, Arial, sans-serif;
          font-size: clamp(2.1rem, 8.3vw, 2.55rem);
          font-weight: 400;
          line-height: 1.12;
          text-decoration: none;
          background: transparent !important;
        }

        #av-burger-menu-ul > li > a .avia-menu-text {
          color: inherit !important;
        }

        #av-burger-menu-ul > li > a .avia-menu-fx,
        #av-burger-menu-ul > li > a .avia-bullet {
          display: none !important;
        }

        .av-width-submenu > a {
          position: relative;
          padding-right: 56px !important;
        }

        .av-width-submenu > a .av-submenu-indicator {
          position: absolute;
          right: 26px;
          top: 50%;
          width: 11px;
          height: 11px;
          margin-top: -5px;
          border-right: 1px solid rgba(255, 255, 255, 0.85);
          border-bottom: 1px solid rgba(255, 255, 255, 0.85);
          transform: rotate(45deg);
        }

        #av-burger-menu-ul .sub-menu {
          margin: 0;
          padding: 0;
          background: rgba(255, 255, 255, 0.04);
        }

        #av-burger-menu-ul .sub-menu > li > a {
          font-size: clamp(1.65rem, 6.8vw, 2.05rem);
          padding-left: 46px;
        }

        #av-burger-menu-ul > li.jld-mobile-language-links {
          opacity: 1;
          transform: none;
          border-bottom: 1px solid rgba(255, 255, 255, 0.22);
          padding: 14px 34px 18px;
        }

        #av-burger-menu-ul > li.jld-mobile-language-links .jld-mobile-language-links__label {
          display: block;
          margin-bottom: 10px;
          color: rgba(244, 244, 244, 0.72);
          font-size: 0.75rem;
          font-weight: 600;
          letter-spacing: 0.08em;
          text-transform: uppercase;
        }

        #av-burger-menu-ul > li.jld-mobile-language-links .jld-mobile-language-links__list {
          display: flex;
          flex-wrap: wrap;
          gap: 10px;
        }

        #av-burger-menu-ul > li.jld-mobile-language-links a.jld-mobile-language-link {
          display: inline-flex;
          align-items: center;
          justify-content: center;
          min-width: 52px;
          height: auto;
          line-height: 1;
          padding: 9px 12px;
          border: 1px solid rgba(255, 255, 255, 0.35);
          border-radius: 999px;
          color: #f4f4f4 !important;
          font-size: 0.9rem;
          font-weight: 600;
          letter-spacing: 0.06em;
          text-decoration: none;
          text-transform: uppercase;
        }

        #av-burger-menu-ul > li.jld-mobile-language-links a.jld-mobile-language-link.is-active {
          border-color: #d7bb7a;
          color: #d7bb7a !important;
        }

        .av-hamburger--spin.is-active .av-hamburger-inner {
          transform: rotate(225deg);
          transition-delay: 0.12s;
          transition-timing-function: cubic-bezier(0.215, 0.61, 0.355, 1);
        }

        .av-hamburger--spin.is-active .av-hamburger-inner::before {
          top: 0;
          opacity: 0;
          transition:
            top 0.1s ease-out,
            opacity 0.1s 0.12s ease-out;
        }

        .av-hamburger--spin.is-active .av-hamburger-inner::after {
          bottom: 0;
          transform: rotate(-90deg);
          transition:
            bottom 0.1s ease-out,
            transform 0.22s 0.12s cubic-bezier(0.215, 0.61, 0.355, 1);
        }
      }

      @media (max-width: 479px) {
        .av-burger-overlay-scroll {
          width: 100vw;
        }
      }

      .av-masonry-container.av-js-disabled .av-masonry-entry {
        visibility: visible;
        opacity: 1;
      }

      .av-masonry-container.av-js-disabled .av-masonry-entry.av-masonry-item-no-image {
        display: none;
      }

      /* Contact form: keep submit button aligned below inputs and make it readable. */
      body.page-id-150 #top .avia_ajax_form p.form_element {
        float: none !important;
        clear: both;
        width: 100%;
      }

      body.page-id-150 #top .avia_ajax_form p.form_element:not(.form_fullwidth) {
        width: 100%;
        margin-top: 18px;
        text-align: left;
      }

      body.page-id-150 #top .avia_ajax_form p.form_element:not(.form_fullwidth) input[type="submit"].button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        max-width: 420px;
        min-height: 54px;
        padding: 0 24px;
        border: 1px solid #b79d69;
        border-radius: 2px;
        background: #b79d69;
        color: #fff;
        font-size: 15px;
        font-weight: 700;
        letter-spacing: 0.02em;
        line-height: 1.2;
        text-transform: uppercase;
        white-space: normal;
      }

      body.page-id-150 #top .avia_ajax_form p.form_element:not(.form_fullwidth) input[type="submit"].button:hover,
      body.page-id-150 #top .avia_ajax_form p.form_element:not(.form_fullwidth) input[type="submit"].button:focus-visible {
        background: #ceb27a;
        border-color: #ceb27a;
        color: #1f2024;
      }

      @media (max-width: 767px) {
        body.page-id-150 #top .avia_ajax_form p.form_element:not(.form_fullwidth) input[type="submit"].button {
          max-width: none;
        }
      }

      .jld-visually-hidden {
        position: absolute !important;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }
    </style>
  </head>
  <body id="top" class={page.bodyClass || undefined}>
    <script
      is:inline
      define:vars={{ route: clientBootRoute, languageLinks: mobileLanguageLinks, languageLabel: mobileLanguageLabel }}
    >
      (() => {
        const currentRoute = typeof route === "string" && route ? route : window.location.pathname;
        document.documentElement.setAttribute("data-jld-clone", "astro");
        document.documentElement.setAttribute("data-jld-route", currentRoute);
        const mobileLanguageEntries = Array.isArray(languageLinks)
          ? languageLinks
              .map((entry) => {
                if (!entry || typeof entry !== "object") return null;
                const code = typeof entry.code === "string" ? entry.code : "";
                const href = typeof entry.href === "string" ? entry.href : "";
                const localeTag = typeof entry.localeTag === "string" ? entry.localeTag : "";
                const active = entry.active === true;

                if (!code || !href || !localeTag) return null;
                return { code, href, localeTag, active };
              })
              .filter(Boolean)
          : [];

        const escapeHtml = (value) =>
          String(value)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;");

        const injectMobileLanguageLinks = () => {
          if (!mobileLanguageEntries.length) return false;

          const burgerMenu = document.getElementById("av-burger-menu-ul");
          if (!(burgerMenu instanceof HTMLElement)) return false;
          if (burgerMenu.querySelector(".jld-mobile-language-links")) return true;

          const linksMarkup = mobileLanguageEntries
            .map((entry) => {
              const activeClass = entry.active ? " is-active" : "";
              const ariaCurrent = entry.active ? ' aria-current="page"' : "";

              return `<a class="jld-mobile-language-link${activeClass}" href="${escapeHtml(entry.href)}" hreflang="${escapeHtml(entry.localeTag)}" lang="${escapeHtml(entry.localeTag)}"${ariaCurrent}>${escapeHtml(entry.code)}</a>`;
            })
            .join("");

          const languageItem = document.createElement("li");
          languageItem.className = "jld-mobile-language-links av-active-burger-items";
          languageItem.setAttribute("role", "menuitem");
          languageItem.innerHTML = `<span class="jld-mobile-language-links__label">${escapeHtml(languageLabel || "Language")}</span><div class="jld-mobile-language-links__list">${linksMarkup}</div>`;
          burgerMenu.appendChild(languageItem);

          return true;
        };

        const scheduleMobileLanguageInjection = () => {
          if (injectMobileLanguageLinks()) return;
          [80, 180, 360, 680].forEach((delay) => {
            window.setTimeout(injectMobileLanguageLinks, delay);
          });
        };

        document.addEventListener("click", (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;

          if (
            target.closest(
              ".av-burger-menu-main, .av-hamburger, .av-hamburger-box, .av-hamburger-inner",
            )
          ) {
            scheduleMobileLanguageInjection();
          }
        });

        const hydratePictureSources = (image) => {
          const picture =
            image.parentElement && image.parentElement.tagName === "PICTURE"
              ? image.parentElement
              : null;

          if (!picture) return;

          picture.querySelectorAll("source[data-srcset]").forEach((source) => {
            const dataSrcSet = source.getAttribute("data-srcset");
            if (dataSrcSet && !source.getAttribute("srcset")) {
              source.setAttribute("srcset", dataSrcSet);
            }
          });
        };

        const hydrateImage = (image) => {
          const src = image.getAttribute("src") || "";
          const dataSrc = image.getAttribute("data-src");
          const dataSrcSet = image.getAttribute("data-srcset");
          const dataSizes = image.getAttribute("data-sizes");
          const isHighPriority = image.getAttribute("fetchpriority") === "high";

          if (dataSrc && (!src || src.startsWith("data:image/"))) {
            image.setAttribute("src", dataSrc);
          }

          if (dataSrcSet && !image.getAttribute("srcset")) {
            image.setAttribute("srcset", dataSrcSet);
          }

          if (dataSizes && !image.getAttribute("sizes")) {
            image.setAttribute("sizes", dataSizes);
          }

          if (!image.hasAttribute("decoding")) {
            image.setAttribute("decoding", "async");
          }

          if (!image.hasAttribute("loading")) {
            image.setAttribute("loading", isHighPriority ? "eager" : "lazy");
          }

          hydratePictureSources(image);
        };

        const shouldHydrateImmediately = (image, index) => {
          if (image.getAttribute("fetchpriority") === "high") return true;
          if (index < 2) return true;

          const rect = image.getBoundingClientRect();
          return rect.top < window.innerHeight * 1.5;
        };

        const hydrateLazyImages = () => {
          const images = Array.from(
            document.querySelectorAll("img[data-src], img[data-srcset], img[data-sizes]"),
          );
          if (!images.length) return;

          const hasObserver = typeof window.IntersectionObserver === "function";
          const observer = hasObserver
            ? new IntersectionObserver(
                (entries, activeObserver) => {
                  entries.forEach((entry) => {
                    if (!entry.isIntersecting) return;
                    if (!(entry.target instanceof HTMLImageElement)) return;

                    hydrateImage(entry.target);
                    activeObserver.unobserve(entry.target);
                  });
                },
                { rootMargin: "260px 0px" },
              )
            : null;

          images.forEach((node, index) => {
            if (!(node instanceof HTMLImageElement)) return;

            if (!observer || shouldHydrateImmediately(node, index)) {
              hydrateImage(node);
              return;
            }

            if (!node.hasAttribute("loading")) {
              node.setAttribute("loading", "lazy");
            }
            observer.observe(node);
          });
        };

        const hydrateLazySources = () => {
          document.querySelectorAll("source[data-srcset]").forEach((source) => {
            const picture = source.closest("picture");
            const pictureImage = picture ? picture.querySelector("img") : null;
            const imageSrc = pictureImage ? pictureImage.getAttribute("src") || "" : "";

            if (imageSrc.startsWith("data:image/")) {
              return;
            }

            const dataSrcSet = source.getAttribute("data-srcset");
            if (dataSrcSet && !source.getAttribute("srcset")) {
              source.setAttribute("srcset", dataSrcSet);
            }
          });
        };

        const revealMasonryFallback = () => {
          document.querySelectorAll(".av-masonry .av-masonry-entry").forEach((entry) => {
            if (entry.classList.contains("av-masonry-item-no-image")) {
              entry.setAttribute("aria-hidden", "true");
              entry.style.display = "none";
              return;
            }

            entry.style.visibility = "visible";
            entry.style.opacity = "1";
          });
        };

        const applyFullscreenSlideBackgrounds = () => {
          document
            .querySelectorAll(".avia-fullscreen-slider .avia-slideshow-inner > li[data-img-url]")
            .forEach((slide) => {
              const imageUrl = slide.getAttribute("data-img-url");
              if (imageUrl && !slide.style.backgroundImage) {
                slide.style.backgroundImage = `url("${imageUrl}")`;
              }
            });
        };

        const runFallbacks = () => {
          hydrateLazyImages();
          hydrateLazySources();
          revealMasonryFallback();
          applyFullscreenSlideBackgrounds();
          injectMobileLanguageLinks();
        };

        const initialize = () => {
          runFallbacks();
          scheduleMobileLanguageInjection();
          [180, 650, 1400].forEach((delay) => {
            window.setTimeout(runFallbacks, delay);
          });
        };

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", initialize, { once: true });
        } else {
          initialize();
        }
      })();
    </script>
    {!hasBodyH1 && <h1 class="jld-visually-hidden">{pageHeading}</h1>}
    <Fragment set:html={localizedBodyHtml} />
  </body>
</html>
