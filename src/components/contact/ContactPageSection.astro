---
import { getContactPageContent } from "../../data/contact";
import type { Locale } from "../../lib/i18n";

const { locale } = Astro.props as { locale: Locale };
const content = getContactPageContent(locale);
const locationIcon = "";
---

<div
  id="av_section_1"
  class="avia-section av-m0okwvnc-47213e7d7744d539444936e8f42bf0e2 alternate_color avia-section-large avia-no-shadow avia-builder-el-2 el_after_av_slideshow_full avia-builder-el-last avia-bg-style-scroll container_wrap fullsize"
>
  <div class="container av-section-cont-open">
    <div class="template-page content av-content-full alpha units">
      <div class="post-entry post-entry-type-page post-entry-150">
        <div class="entry-content-wrapper clearfix">
          <div class="av-special-heading av-m0okyjw0-e37efc7258f4331071ec03ce61e523bd av-special-heading-h2 blockquote modern-quote modern-centered avia-builder-el-3 el_before_av_textblock avia-builder-el-first">
            <h2 class="av-special-heading-tag" itemprop="headline">{content.heading}</h2>
            <div class="special-heading-border">
              <div class="special-heading-inner-border"></div>
            </div>
          </div>

          <section class="av_textblock_section av-m0ol26fh-863b9e58f840357bff157f1da72d0c23" itemscope="itemscope" itemtype="https://schema.org/CreativeWork">
            <div class="avia_textblock" itemprop="text">
              <p style="text-align: center;">{content.intro}</p>
            </div>
          </section>

          <div class="flex_column av-tn7e-20781cbbe552f1cb15591b752d9720cd av_one_full avia-builder-el-5 el_after_av_textblock el_before_av_two_third first flex_column_div column-top-margin">
            <div class="av-special-heading av-m0pou51q-01e9f12929709be6c96eb0327eb5b68d av-special-heading-h2 blockquote modern-quote modern-centered avia-builder-el-6 el_before_av_button avia-builder-el-first">
              <h2 class="av-special-heading-tag" itemprop="headline">{content.ctaTitle}</h2>
              <div class="special-heading-border">
                <div class="special-heading-inner-border"></div>
              </div>
            </div>
            <div class="avia-button-wrap av-m0poxjb6-52920109bca6a7f26c08957562782947-wrap avia-button-center avia-builder-el-7 el_after_av_heading avia-builder-el-last">
              <a
                href={content.ctaHref}
                class="avia-button av-m0poxjb6-52920109bca6a7f26c08957562782947 av-link-btn avia-icon_select-yes-right-icon avia-size-x-large avia-position-center av-icon-on-hover avia-color-theme-color"
                aria-label={content.ctaAriaLabel}
              >
                <span class="avia_iconbox_title">{content.ctaLabel}</span>
                <span class="avia_button_icon avia_button_icon_right" aria-hidden="true" data-av_icon="" data-av_iconfont="entypo-fontello"></span>
              </a>
            </div>
          </div>

          <div class="flex_column av-lx4am-8e82d22e9b6d568cdf6e5afe19bb278d av_two_third avia-builder-el-8 el_after_av_one_full el_before_av_one_third first flex_column_div column-top-margin">
            <div class="av-special-heading av-m0q2dn00-eb13aadad2abfd2b047d486941e88aa1 av-special-heading-h2 blockquote modern-quote avia-builder-el-9 el_before_av_contact avia-builder-el-first">
              <h2 class="av-special-heading-tag" itemprop="headline">{content.formHeading}</h2>
              <div class="special-heading-border">
                <div class="special-heading-inner-border"></div>
              </div>
            </div>
            <form
              action={content.formAction}
              method="post"
              data-fields-with-error={content.fieldsWithError}
              class="avia_ajax_form av-form-labels-hidden avia-builder-el-10 el_after_av_heading avia-builder-el-last"
              data-avia-form-id="1"
              data-avia-redirect=""
            >
              <fieldset>
                <p class="first_form form_element form_fullwidth" id="element_avia_1_1">
                  <label for={content.formFields.name.id}>
                    {content.formFields.name.label} <abbr class="required" title="required">*</abbr>
                  </label>
                  <input
                    name={content.formFields.name.name}
                    class={content.formFields.name.className}
                    type="text"
                    id={content.formFields.name.id}
                    value=""
                    placeholder={content.formFields.name.placeholder}
                  />
                </p>
                <p class="first_form form_element form_fullwidth" id="element_avia_2_1">
                  <label for={content.formFields.phone.id}>
                    {content.formFields.phone.label} <abbr class="required" title="required">*</abbr>
                  </label>
                  <input
                    name={content.formFields.phone.name}
                    class={content.formFields.phone.className}
                    type="text"
                    id={content.formFields.phone.id}
                    value=""
                    placeholder={content.formFields.phone.placeholder}
                  />
                </p>
                <p class="first_form form_element form_fullwidth" id="element_avia_3_1">
                  <label for={content.formFields.email.id}>{content.formFields.email.label}</label>
                  <input
                    name={content.formFields.email.name}
                    class={content.formFields.email.className}
                    type="text"
                    id={content.formFields.email.id}
                    value=""
                    placeholder={content.formFields.email.placeholder}
                  />
                </p>
                <p class="first_form form_element form_fullwidth" id="element_avia_4_1">
                  <label for={content.formFields.message.id} class="textare_label hidden textare_label_avia_4_1">{content.formFields.message.label}</label>
                  <textarea
                    placeholder={content.formFields.message.placeholder}
                    name={content.formFields.message.name}
                    class={content.formFields.message.className}
                    cols="40"
                    rows="7"
                    id={content.formFields.message.id}
                  ></textarea>
                </p>
                <p class="hidden">
                  <input
                    type="text"
                    name={content.formFields.honeypot.name}
                    class={content.formFields.honeypot.className}
                    id={content.formFields.honeypot.id}
                    value=""
                  />
                </p>
                <p class="form_element form_fullwidth jld-submit-row">
                  <input type="hidden" value="1" name="avia_generated_form1" />
                  <input
                    type="submit"
                    value={content.submitLabel}
                    class="button"
                    data-sending-label={content.sendingLabel}
                  />
                </p>
              </fieldset>
            </form>
            <div id="ajaxresponse_1" class="ajaxresponse ajaxresponse_1 hidden"></div>
          </div>

          <div class="flex_column av-eko8e-ffcd0250b5889ae5d9f49d84fc7165c9 av_one_third avia-builder-el-11 el_after_av_two_third avia-builder-el-last flex_column_div column-top-margin">
            <div class="av-special-heading av-8o9mm-d2d63dffd5a2a7d01698594ac59fd6b7 av-special-heading-h2 blockquote modern-quote avia-builder-el-12 el_before_av_iconlist avia-builder-el-first">
              <h2 class="av-special-heading-tag" itemprop="headline">{content.contactDetailsHeading}</h2>
              <div class="special-heading-border">
                <div class="special-heading-inner-border"></div>
              </div>
            </div>
            <div class="avia-icon-list-container av-m0q2kasm-ab43d7718339c03dbebaf8c9f52335b4 avia-builder-el-13 el_after_av_heading avia-builder-el-last">
              <ul class="avia-icon-list avia_animate_when_almost_visible avia-icon-list-left av-iconlist-big av-m0q2kasm-ab43d7718339c03dbebaf8c9f52335b4 avia-iconlist-animate">
                {content.cards.map((card) => (
                  <li>
                    <div class={`iconlist_icon ${card.iconClass} avia-font-entypo-fontello`}>
                      <span class="iconlist-char" aria-hidden="true" data-av_icon={locationIcon} data-av_iconfont="entypo-fontello"></span>
                    </div>
                    <article class="article-icon-entry" itemscope="itemscope" itemtype="https://schema.org/CreativeWork">
                      <div class="iconlist_content_wrap">
                        <header class="entry-content-header">
                          <h4 class="av_iconlist_title iconlist_title" itemprop="headline">{card.title}</h4>
                        </header>
                        <div class="iconlist_content" itemprop="text">
                          <p>
                            {card.lines.map((line, index) => (
                              <>
                                {index > 0 && <br />}
                                {line}
                              </>
                            ))}
                          </p>
                        </div>
                      </div>
                      <footer class="entry-footer"></footer>
                    </article>
                    <div class="iconlist-timeline"></div>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
