---

<div class="jld-gift-page">
  <section class="jld-gift-hero">
    <div class="jld-gift-shell jld-gift-hero__inner" data-gift-reveal style="--reveal-delay: 0ms;">
      <div class="jld-gift-hero__content">
        <span class="jld-gift-eyebrow">{content.eyebrow}</span>
        <h1>{content.title}</h1>
        <p class="jld-gift-hero__lede">{content.subtitle}</p>

        <div class="jld-gift-hero__actions">
          <a href="#" class="jld-gift-button jld-gift-button--solid">
            {content.primaryCta}
          </a>
        </div>
      </div>

      <div class="jld-gift-hero__visual" aria-hidden="true">
        <div class="jld-gift-hero-stack">
          <div class="jld-gift-hero-card jld-gift-hero-card--back"></div>
          <div class="jld-gift-hero-card jld-gift-hero-card--front">
            <span class="jld-gift-hero-card__brand">Jean Louis David</span>
            <strong class="jld-gift-hero-card__title">Gift Card</strong>
            <span class="jld-gift-hero-card__amount">MXN 1,000</span>
            <div class="jld-gift-hero-card__divider"></div>
            <span class="jld-gift-hero-card__caption">Premium beauty experience</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="jld-gift-section jld-gift-section--cards">
    <div class="jld-gift-shell">
      <div class="jld-gift-section__header" data-gift-reveal style="--reveal-delay: 40ms;">
        <span class="jld-gift-eyebrow">{content.cardsEyebrow}</span>
        <h2>{content.cardsTitle}</h2>
        <p>{content.cardsDescription}</p>
      </div>

      <div class="jld-gift-card-grid">
        {content.cards.map((card, index) => (
          <article
            class="jld-gift-card"
            data-gift-reveal
            style={`--reveal-delay: ${120 + index * 80}ms;`}
          >
            <div class="jld-gift-card__topline">
              <span class="jld-gift-card__brand">Jean Louis David</span>
              <span class="jld-gift-card__accent">{card.accent}</span>
            </div>

            <div class="jld-gift-card__amount">{card.amount}</div>
            <p class="jld-gift-card__description">{card.description}</p>

            <div class="jld-gift-card__qr" aria-hidden="true">
              <span>{content.qrLabel}</span>
            </div>

            <div class="jld-gift-card__actions">
              <a href="#" class="jld-gift-button jld-gift-button--solid jld-gift-button--small">
                {content.buyLabel}
              </a>
              <a href="#" class="jld-gift-button jld-gift-button--ghost jld-gift-button--small">
                {content.infoLabel}
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="jld-gift-section jld-gift-section--how">
    <div class="jld-gift-shell">
      <div class="jld-gift-section__header" data-gift-reveal style="--reveal-delay: 40ms;">
        <span class="jld-gift-eyebrow">{content.howEyebrow}</span>
        <h2>{content.howTitle}</h2>
        <p>{content.howDescription}</p>
      </div>

      <div class="jld-gift-steps">
        {content.steps.map((step, index) => (
          <article
            class="jld-gift-step"
            data-gift-reveal
            style={`--reveal-delay: ${100 + index * 80}ms;`}
          >
            <span class="jld-gift-step__number">0{index + 1}</span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="jld-gift-section jld-gift-section--ideal">
    <div class="jld-gift-shell">
      <div class="jld-gift-section__header" data-gift-reveal style="--reveal-delay: 40ms;">
        <span class="jld-gift-eyebrow">{content.idealEyebrow}</span>
        <h2>{content.idealTitle}</h2>
        <p>{content.idealDescription}</p>
      </div>

      <div class="jld-gift-highlights">
        {content.highlights.map((highlight, index) => (
          <article
            class="jld-gift-highlight"
            data-gift-reveal
            style={`--reveal-delay: ${100 + index * 80}ms;`}
          >
            <h3>{highlight.title}</h3>
            <p>{highlight.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="jld-gift-section jld-gift-section--terms">
    <div class="jld-gift-shell">
      <div class="jld-gift-terms" data-gift-reveal style="--reveal-delay: 60ms;">
        <span class="jld-gift-eyebrow">{content.termsLabel}</span>
        <p>{content.termsText}</p>
      </div>
    </div>
  </section>
</div>

<script is:inline>
  const giftPageRoot = document.querySelector(".jld-gift-page");

  if (giftPageRoot instanceof HTMLElement && "IntersectionObserver" in window) {
    const revealTargets = Array.from(giftPageRoot.querySelectorAll("[data-gift-reveal]"));
    giftPageRoot.classList.add("is-reveal-ready");

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        });
      },
      {
        threshold: 0.18,
        rootMargin: "0px 0px -8% 0px",
      },
    );

    revealTargets.forEach((target, index) => {
      if (index < 2) {
        target.classList.add("is-visible");
      }

      observer.observe(target);
    });
  }
</script>

<style>
