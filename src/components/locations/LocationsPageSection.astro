              </div>
            </div>
            <section class="av_textblock_section av-m0poadaq-88fb2f5e99e5acc01a49017487cd049b" itemscope="itemscope" itemtype="https://schema.org/CreativeWork">
              <div class="avia_textblock" itemprop="text">
                <p style="text-align: center;">
                  <strong>{polanco.venue}</strong>
