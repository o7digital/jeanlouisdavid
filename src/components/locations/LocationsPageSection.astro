            </div>
            <section class="av_textblock_section av-m0po7hgc-21653ad20cfb45ca28dbe5fe7938afba" itemscope="itemscope" itemtype="https://schema.org/CreativeWork">
              <div class="avia_textblock" itemprop="text">
                <p style="text-align: center;">
                  <strong>{santaFe.venue}</strong>
                </p>
                <p style="text-align: center;">
                  {santaFe.addressLines[0]}
                  <br />
                  {santaFe.addressLines[1]}
                  <br />
                  {santaFe.addressLines[2]}
                </p>
                <p style="text-align: center;">{santaFe.phone}</p>
