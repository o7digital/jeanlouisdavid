---
import { getLocationsPageContent } from "../../data/locations";
import type { Locale } from "../../lib/i18n";

const { locale } = Astro.props as { locale: Locale };
const content = getLocationsPageContent(locale);
const [santaFe, polanco] = content.locations;

const locationIcon = "";
