---
import type { IconName } from "../../data/central-system";

const { name, class: className } = Astro.props as {
  name: IconName;
  class?: string;
};
---

{
  name === "grid" && (
    <svg viewBox="0 0 24 24" aria-hidden="true" class={className}>
      <rect x="3" y="3" width="7" height="7" rx="2"></rect>
      <rect x="14" y="3" width="7" height="7" rx="2"></rect>
      <rect x="3" y="14" width="7" height="7" rx="2"></rect>
      <rect x="14" y="14" width="7" height="7" rx="2"></rect>
    </svg>
  )
}
{
  name === "pulse" && (
    <svg viewBox="0 0 24 24" aria-hidden="true" class={className}>
      <path d="M3 12h4l2-4 4 9 2-5h6"></path>
    </svg>
  )
}
{
  name === "users" && (
    <svg viewBox="0 0 24 24" aria-hidden="true" class={className}>
      <circle cx="9" cy="8" r="3"></circle>
      <path d="M3 20c0-3.2 2.7-5 6-5s6 1.8 6 5"></path>
      <path d="M17 9c2 0 4 1.5 4 4"></path>
    </svg>
  )
}
{
  name === "bottle" && (
    <svg viewBox="0 0 24 24" aria-hidden="true" class={className}>
      <path d="M10 3h4"></path>
      <path d="M11 3v4l-3 4v7a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2v-7l-3-4V3"></path>
    </svg>
  )
}
{
  name === "search" && (
    <svg viewBox="0 0 24 24" aria-hidden="true" class={className}>
      <circle cx="11" cy="11" r="6"></circle>
      <path d="M20 20l-4.2-4.2"></path>
    </svg>
  )
}
{
  name === "clock" && (
    <svg viewBox="0 0 24 24" aria-hidden="true" class={className}>
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M12 7v6l4 2"></path>
    </svg>
  )
}
{
  name === "chart" && (
    <svg viewBox="0 0 24 24" aria-hidden="true" class={className}>
      <path d="M4 19h16"></path>
      <rect x="5" y="11" width="3" height="6" rx="1"></rect>
      <rect x="10.5" y="8" width="3" height="9" rx="1"></rect>
      <rect x="16" y="5" width="3" height="12" rx="1"></rect>
    </svg>
  )
}
{
  name === "shield" && (
    <svg viewBox="0 0 24 24" aria-hidden="true" class={className}>
      <path d="M12 3l7 3v5c0 5-3 8-7 10-4-2-7-5-7-10V6l7-3z"></path>
    </svg>
  )
}
{
  name === "store" && (
    <svg viewBox="0 0 24 24" aria-hidden="true" class={className}>
      <path d="M4 9l1-4h14l1 4"></path>
      <path d="M5 9h14v10H5z"></path>
      <path d="M9 19v-5h6v5"></path>
    </svg>
  )
}
{
  name === "spark" && (
    <svg viewBox="0 0 24 24" aria-hidden="true" class={className}>
      <path d="M12 3l1.6 4.4L18 9l-4.4 1.6L12 15l-1.6-4.4L6 9l4.4-1.6L12 3z"></path>
    </svg>
  )
}
{
  name === "list" && (
    <svg viewBox="0 0 24 24" aria-hidden="true" class={className}>
      <path d="M8 6h12"></path>
      <path d="M8 12h12"></path>
      <path d="M8 18h12"></path>
      <circle cx="4" cy="6" r="1"></circle>
      <circle cx="4" cy="12" r="1"></circle>
      <circle cx="4" cy="18" r="1"></circle>
    </svg>
  )
}
{
  name === "box" && (
    <svg viewBox="0 0 24 24" aria-hidden="true" class={className}>
      <path d="M4 7l8-4 8 4-8 4-8-4z"></path>
      <path d="M4 7v10l8 4 8-4V7"></path>
      <path d="M12 11v10"></path>
    </svg>
  )
}
