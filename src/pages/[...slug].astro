---
import MirroredDocument from "../components/MirroredDocument.astro";
import { DEFAULT_LOCALE } from "../lib/i18n";
import { MIRRORED_PAGES, getMirroredPage } from "../lib/mirror";

export function getStaticPaths() {
  return MIRRORED_PAGES.filter((page) => page.route !== "/").map((page) => ({
    params: {
      slug: page.route.replace(/^\/|\/$/g, ""),
    },
    props: {
      route: page.route,
    },
  }));
}

const { route } = Astro.props as { route: string };
const page = getMirroredPage(route);
---

<MirroredDocument page={page} locale={DEFAULT_LOCALE} />
