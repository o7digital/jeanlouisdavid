---
import MirroredDocument from "../../components/MirroredDocument.astro";
import { NON_DEFAULT_LOCALES, normalizeLocale } from "../../lib/i18n";
import { getMirroredPage } from "../../lib/mirror";

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((locale) => ({
    params: { locale },
    props: { locale },
  }));
}

const { locale: rawLocale } = Astro.props as { locale: string };
const locale = normalizeLocale(rawLocale);
const page = getMirroredPage("/");
---

<MirroredDocument page={page} locale={locale} />
